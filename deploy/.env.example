# Copy to deploy/.env for local overrides. That path is gitignored.
# NEVER commit real secrets.

# --- Database -----------------------------------------------------------
# Accepts either JDBC form or the postgres://user:pass@host:port/db URL that
# Render injects; the application normalises the latter at startup.
DATABASE_URL=jdbc:postgresql://localhost:5432/lms
DATABASE_USERNAME=lms
DATABASE_PASSWORD=
DB_POOL_MAX=5

# --- JWT signing keypair (RS256) ----------------------------------------
# Omit both in local development and the application generates an ephemeral
# keypair at startup -- tokens then die with the process, which is what you
# want locally and must never happen in production.
#
# Mint a production pair:
#
#   openssl genpkey -algorithm RSA -pkcs8 -out jwt-private.pem \
#     -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#
# Then paste each file's full contents (BEGIN/END lines included) as a secret.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_ACCESS_TTL=PT1H
JWT_REFRESH_TTL=P30D

# --- HTTP ---------------------------------------------------------------
PORT=8080
TOMCAT_THREADS_MAX=20
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Telematics ---------------------------------------------------------
PING_RETENTION_DAYS=7
PING_MAX_BATCH=500
PING_MAX_SPEED_KMH=160
ROUTE_DEVIATION_METRES=2000

# --- Logging ------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
