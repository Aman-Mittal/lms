# Backup schedule for a host running the DR stack (crontab -e). Times are the
# host's local time; adjust to the quiet hours. RPO does not depend on this
# schedule -- continuous WAL archiving bounds it at about a minute -- but RTO
# does: fewer WAL segments to replay after the nearest backup means a faster
# restore, which is what the hourly incremental buys.
#
# Logs go to syslog via logger; alert on a missing "backup finished" line.

LMS=/opt/lms

# Weekly full, Sunday 02:15.
15 2 * * 0    cd $LMS && bash deploy/dr/backup.sh full 2>&1 | logger -t lms-dr-backup
# Daily differential, Monday to Saturday 02:15.
15 2 * * 1-6  cd $LMS && bash deploy/dr/backup.sh diff 2>&1 | logger -t lms-dr-backup
# Hourly incremental at :45 (clear of the 02:15 full/diff).
45 * * * *    cd $LMS && bash deploy/dr/backup.sh incr 2>&1 | logger -t lms-dr-backup
# Daily logical dump at 03:30, keeping the last 7.
30 3 * * *    cd $LMS && bash deploy/dr/logical-backup.sh 2>&1 | logger -t lms-dr-logical
# Weekly repository verification (checksums of every file in the repo).
30 4 * * 0    cd $LMS && docker compose -p lms-dr -f deploy/dr/docker-compose.dr.yml exec -T -u postgres postgres pgbackrest --stanza=lms verify 2>&1 | logger -t lms-dr-verify
