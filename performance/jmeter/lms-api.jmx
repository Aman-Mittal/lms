              <intProp name="Assertion.test_type">1</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Carries every consignment">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">def count = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).consignmentCount as String; if (count != vars.get(&quot;bulkCount&quot;)) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&quot;load carries &quot; + count + &quot; of &quot; + vars.get(&quot;bulkCount&quot;)) }</stringProp>
            </JSR223Assertion>
