      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Public tracking readers">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(publicThreads,2)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(publicRampSeconds,2)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(publicDurationSeconds,20)}</stringProp>
      </ThreadGroup>
      <hashTree>
          <!-- A group of its own because the one above sends a bearer token on every
               request, and the public route is the one that must be read without one:
               what a customer holding only a link does. Groups run one after the other. -->
